{
  "manifest_version": 3,
  "name": "FoxyWall Proxy",
  "version": "1.2.0",
  "description": "Route your browser traffic through your FoxyWall proxy server. Pro account required.",
  "permissions": [
    "proxy",
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "webRequest",
    "webRequestAuthProvider",
    "sidePanel",
    "background"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FoxyWall Proxy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
