{
  "manifest_version": 3,
  "name": "SMS Activate",
  "version": "1.0.0",
  "description": "Request a phone number and receive its SMS verification code via OnlineSim.",
  "permissions": ["storage", "sidePanel", "clipboardWrite"],
  "host_permissions": ["https://onlinesim.io/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "SMS Activate",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
