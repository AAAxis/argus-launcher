VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-your-project-anon-key
MONTI_BROWSER_APP=/Applications/Monti Browser.app
# Where the sign-in screen sends "Create an account" / "Forgot password?".
# Optional -- defaults to https://www.montigate.com. Point at
# http://localhost:3000 to test against a local landing site (only honoured
# when the launcher runs with MONTI_LAUNCHER_DEV=1).
VITE_SITE_URL=https://www.montigate.com
